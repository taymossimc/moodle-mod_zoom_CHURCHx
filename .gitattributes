# Normalize line endings to LF for cross-platform development (Linux server, etc.).
* text=auto eol=lf

# Source and config
*.php text eol=lf
*.js text eol=lf
*.mustache text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.feature text eol=lf
*.sh text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.html text eol=lf
*.dist text eol=lf

# Binary assets
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
